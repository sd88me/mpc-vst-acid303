{
  "name": "Acid-303",
  "vendor": "sd88me",
  "uid": "A303",
  "version": 1001,
  "targets": [
    "armv7",
    "aarch64"
  ],
  "so": "acid303.so",
  "params": "params.json",
  "build": {
    "root": "..",
    "sources": [
      "vst/engine.cpp",
      "src/lemus/voice.cpp",
      "src/lemus/oversampler.cpp"
    ],
    "cflags": [
      "-Isrc/lemus",
      "-O3",
      "-std=gnu++17",
      "-ffast-math",
      "-fno-finite-math-only"
    ],
    "cflags_arm": [
      "-mcpu=cortex-a17",
      "-mfpu=neon-vfpv4"
    ],
    "libs": [
      "-lm"
    ]
  },
  "layout": "layout.conf",
  "art": "html",
  "tile": "art/tile.png"
}